PORT=3003
MONGO_URI=mongodb://localhost:27017/HiveMindOrder
JWT_SECRET=replace_with_a_long_random_string_shared_by_all_services
CORS_ORIGIN=http://localhost:5173
RABBIT_URL=amqp://guest:guest@localhost:5672
CART_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3001
INTERNAL_API_KEY=replace_with_a_long_random_string_shared_with_product
RATE_LIMIT_MAX=1000

# Seconds between simulated fulfilment stages (six steps from paid to delivered).
# Set FULFILMENT_SIMULATION=off to stop orders progressing on their own.
FULFILMENT_STEP_SECONDS=45
